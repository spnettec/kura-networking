echo ""
echo "Uninstalling Kura firewall-only support..."

if command -v systemctl > /dev/null 2>&1; then
    systemctl disable firewall > /dev/null 2>&1 || true
    systemctl daemon-reload > /dev/null 2>&1 || true
fi

if [ -f /opt/eclipse/kura/framework/kura.properties ]; then
    sed -i "s|^#*kura.have.firewall.admin=.*|kura.have.firewall.admin=false|" \
        /opt/eclipse/kura/framework/kura.properties
fi
