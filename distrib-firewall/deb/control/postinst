case "$1" in
    configure)
        ;;

    abort-remove|abort-upgrade)
        echo "Installation did not complete."
        exit 1
        ;;

    *)
        echo "postinst script called with unknown parameter $1"
        exit 1
        ;;
esac

echo "Installing Kura firewall-only support..."

disable_placeholder_rules_file() {
    local rules_file="$1"
    local disabled_file

    if [ ! -f "$rules_file" ]; then
        return
    fi

    if ! grep -Eq "ETH_INTERFACE_|WIFI_INTERFACE_" "$rules_file"; then
        return
    fi

    disabled_file="${rules_file}.kura-firewall-only-disabled"
    if [ -e "$disabled_file" ]; then
        disabled_file="${disabled_file}.$(date +%Y%m%d%H%M%S)"
    fi

    mv "$rules_file" "$disabled_file"
    echo "Disabled placeholder firewall rules: $rules_file -> $disabled_file"
}

set_kura_property() {
    local key="$1"
    local value="$2"
    local properties_file=/opt/eclipse/kura/framework/kura.properties

    if [ ! -f "$properties_file" ]; then
        return
    fi

    if grep -q "^#*${key}=" "$properties_file"; then
        sed -i "s|^#*${key}=.*|${key}=${value}|" "$properties_file"
    else
        echo "${key}=${value}" >> "$properties_file"
    fi
}

if [ ! -d /etc/sysconfig ]; then
    mkdir /etc/sysconfig
fi

disable_placeholder_rules_file /etc/sysconfig/iptables
disable_placeholder_rules_file /etc/sysconfig/ip6tables

customize_snapshots() {
    # Kura loads the snapshot with the *largest numeric suffix* at startup, not
    # snapshot_0.xml. Editing only snapshot_0.xml is silently ignored on any
    # device that has accumulated timestamped snapshots from prior runs. So
    # patch BOTH: snapshot_0.xml (the baseline / restore target) AND the latest
    # timestamped snapshot (what's actually loaded next boot).
    # The python script is idempotent — it skips if FirewallConfigurationService
    # is already present in the file.
    local snapshots_dir=/opt/eclipse/kura/user/snapshots
    local script=/opt/eclipse/kura/kura-firewall-install/customize_firewall_snapshot.py

    if [ ! -d "$snapshots_dir" ] || [ ! -f "$script" ]; then
        return
    fi

    if [ -f "$snapshots_dir/snapshot_0.xml" ]; then
        python3 "$script" "$snapshots_dir/snapshot_0.xml"
    fi

    # Find the snapshot with the largest numeric suffix (excluding snapshot_0).
    local latest
    latest="$(find "$snapshots_dir" -maxdepth 1 -name 'snapshot_*.xml' -printf '%f\n' 2>/dev/null \
              | awk -F'snapshot_|\\.xml' '$2 ~ /^[0-9]+$/ && $2 != "0" {print $2}' \
              | sort -n \
              | tail -1)"

    if [ -n "$latest" ] && [ -f "$snapshots_dir/snapshot_${latest}.xml" ]; then
        python3 "$script" "$snapshots_dir/snapshot_${latest}.xml"
    fi
}

customize_snapshots

set_kura_property kura.have.firewall.admin true

# Register this sibling in the kura-core install-order registry, identically to
# every other sibling. kura-firewall-only installs under siblings/firewall/, so
# it registers the name "firewall" (the mutually-exclusive kura-networking
# registers "networking"). Idempotent.
register_sibling() {
    local sibling_name="firewall"
    local registry=/opt/eclipse/kura/framework/sibling-install-order
    if [ -f "$registry" ]; then
        if ! grep -qFx "$sibling_name" "$registry"; then
            echo "  Registering $sibling_name in sibling-install-order"
            echo "$sibling_name" >> "$registry"
        else
            echo "  $sibling_name already registered in sibling-install-order"
        fi
    else
        echo "  Creating sibling-install-order registry"
        mkdir -p /opt/eclipse/kura/framework 2>/dev/null || true
        echo "$sibling_name" > "$registry"
        chown kurad:kurad "$registry" 2>/dev/null || true
        chmod 664 "$registry" 2>/dev/null || true
    fi
}

register_sibling

if command -v systemctl > /dev/null 2>&1; then
    systemctl daemon-reload > /dev/null 2>&1 || true
    systemctl disable firewall > /dev/null 2>&1 || true
fi

sync

echo "Kura firewall-only installation completed."
